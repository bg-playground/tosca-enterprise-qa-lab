    "docs:pdf": "node scripts/build-pdf.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^20.19.0",
    "marked": "^15.0.12",
    "typescript": "5.9.3"
  }
}
